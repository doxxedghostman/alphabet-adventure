# Capacitor regenerates these from package.json every time `npx cap
# sync` runs (their own header literally says "DO NOT EDIT THIS FILE!
# IT IS GENERATED EACH TIME..."). Tracking them means every machine's
# local sync collides with whatever the last person to sync+push
# happened to have installed - not real source, shouldn't be in git.
android/app/capacitor.build.gradle
android/capacitor.settings.gradle
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
