<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches src/config.js's LETTERBOX_BG_HEX (#e8d3a8, a light
         creamy tan) - used for index.html's #game-frame/body and the
         Phaser canvas's own backgroundColor. Deliberately NOT
         APP_BG_COLOR (the dark forest green used for in-game HUD bars)
         - this is specifically the color of the thin letterbox strip
         outside the canvas, which sits directly against this native
         window background during the brief gap before the WebView
         loads, so the two must match or that handoff shows a visible
         color flash. Keep in sync by hand if either changes - same
         caveat as index.html's copy of this constant. -->
    <color name="colorPrimary">#e8d3a8</color>
    <color name="colorPrimaryDark">#8b7f65</color>
    <!-- Matches the gold "Play" button / letter-tile accent color. -->
    <color name="colorAccent">#f2b705</color>
</resources>
